// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
//
// TypeScript 7 removed `baseUrl` (TS5102). The inherited
// @docusaurus/tsconfig preset still sets `"baseUrl": "."`, so it is reset to
// null here, and `paths` is re-declared locally so `@site/*` resolves
// relative to this file (docs/) rather than to the preset's package dir.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    },
    "ignoreDeprecations": "6.0",
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
