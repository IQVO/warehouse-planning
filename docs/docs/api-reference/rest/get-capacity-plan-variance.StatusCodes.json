{"responses":{"200":{"description":"The variance.","content":{"application/json":{"schema":{"type":"object","required":["plan_id","location","step","window_start","window_end","planned_orders_per_hour","planned_orders_over_window","observed","comparison","advisory"],"properties":{"plan_id":{"type":"string","example":"0b7a4c1e-5d52-4f0e-9a39-6c1f2f3a8b10"},"location":{"type":"string","example":"SIM1"},"step":{"type":"string","description":"The plan's bottleneck step, whose task completions are compared.","example":"PACK"},"window_start":{"type":"string","format":"date-time"},"window_end":{"type":"string","format":"date-time"},"planned_orders_per_hour":{"type":"number","format":"double","description":"The plan's path capacity, ORDER per HOUR.","example":1000},"planned_orders_over_window":{"type":"number","format":"double","description":"The plan's capacity over the window, in orders.","example":8000},"observed":{"type":"object","required":["source","has_data","tasks","tasks_per_hour","mean_task_seconds","as_of"],"properties":{"source":{"type":"string","enum":["fulfillment-execution"]},"has_data":{"type":"boolean","description":"False means nothing was observed -- never zero throughput."},"tasks":{"type":"integer","format":"int64","minimum":0,"description":"Tasks completed for the step at the location in the window.","example":21000},"tasks_per_hour":{"type":"number","format":"double","example":2625},"mean_task_seconds":{"type":"number","format":"double","nullable":true,"description":"Mean task duration; null when no completion carried a duration."},"as_of":{"type":"string","format":"date-time","nullable":true,"description":"CloudEvents time of the newest completion the model reflects for the site; null when none."}}},"comparison":{"type":"object","required":["comparable","tasks_per_order","observed_orders","variance_orders","variance_percent"],"properties":{"comparable":{"type":"boolean","description":"False when tasks_per_order was not supplied or nothing was observe